      "<figure class=\"lc-article-viz lc-theme-diagram\" data-ledger-visual=\"themes\" aria-labelledby=\"lc-theme-title\">\n    <header class=\"lc-theme-heading\"><h3 data-lc-en=\"Light &amp; dark\" data-lc-zh=\"深浅主题\" id=\"lc-theme-title\">Light &amp; dark</h3></header>\n    <div class=\"lc-theme-flow\">\n      <div class=\"lc-theme-node\" title=\"tokens.json → build-tokens.mjs → tokens.css + tokens.ts\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z\"/><path d=\"M14 3v6h6M8 13h8M8 17h5\"/></svg><strong data-lc-en=\"Tokens\" data-lc-zh=\"令牌\" >Tokens</strong><small class=\"lc-theme-stack\">JSON · Node.js</small></div><span class=\"lc-theme-arrow\" aria-hidden=\"true\">→</span>\n      <div class=\"lc-theme-modes\"><div class=\"lc-theme-mode\" title=\"tokens.css\">\n      <div class=\"lc-theme-mini\" style=\"--mt-page:#08080D;--mt-surface:#141419;--mt-ink:#FFFFFF;--mt-muted:#B5B2C0;--mt-action:#6925F9;--mt-on-action:#FFFFFF\" aria-hidden=\"true\"><div class=\"lc-theme-mini-bar\"><i></i><span></span></div><div class=\"lc-theme-mini-card\"><strong>Aa 123</strong><span></span><span></span><i>↗</i></div></div>\n      <h4 data-lc-en=\"Dark\" data-lc-zh=\"深色\" >Dark</h4>\n      <small data-lc-en=\"CSS variables\" data-lc-zh=\"CSS 变量\" class=\"lc-theme-stack\">CSS variables</small>\n    </div><div class=\"lc-theme-mode\" title=\"themes.css\">\n      <div class=\"lc-theme-mini\" style=\"--mt-page:#f6f5fa;--mt-surface:#ffffff;--mt-ink:#191622;--mt-muted:#625b70;--mt-action:#6925f9;--mt-on-action:#FFFFFF\" aria-hidden=\"true\"><div class=\"lc-theme-mini-bar\"><i></i><span></span></div><div class=\"lc-theme-mini-card\"><strong>Aa 123</strong><span></span><span></span><i>↗</i></div></div>\n      <h4 data-lc-en=\"Light\" data-lc-zh=\"浅色\" >Light</h4>\n      <small data-lc-en=\