        "$value": "'Switzer Variable', 'Segoe UI', system-ui, sans-serif"
      },
      "mono": {
        "$value": "'JetBrains Mono', 'SFMono-Regular', Consolas, monospace"
      }
    },
    "size": {
      "$type": "fontSize",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "md": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.375rem"
      },
      "2xl": {
        "$value": "1.75rem"
      }
    },
