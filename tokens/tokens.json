      "$type": "fontWeight",
      "regular": {
        "$value": "400"
      },
      "medium": {
        "$value": "500"
      },
      "semibold": {
        "$value": "600"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "0.25rem"
    },
    "md": {
      "$value": "30px"
    },
    "lg": {
      "$value": "24px"
    },
    "pill": {
      "$value": "999px"
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "120ms"
    },
    "normal": {
      "$value": "200ms"
    },
    "slow": {
      "$value": "320ms"
    }
  },
  "easing": {
    "standard": {
      "$value": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "emphasized": {
      "$value": "cubic-bezier(0.3, 0, 0, 1)"
    }
  },
  "z-index": {
    "sticky": {
      "$value": "10"
    },
    "overlay": {
      "$value": "100"
    },
    "drawer": {
      "$value": "110"
    }
  }
